{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "stuvvion/stuvgraph-api",
    "type": "project",
    "description": "STUVGRAPH — Enterprise Hybrid DXP, Headless CMS, and AI-powered Content Platform built with Laravel.",
    "keywords": [
        "stuvgraph",
        "stuvvion",
        "laravel",
        "cms",
        "dxp",
        "headless-cms",
        "content-management",
        "content-api",
        "rest-api",
        "graphql",
        "enterprise",
        "digital-experience-platform",
        "artificial-intelligence"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "bacon/bacon-qr-code": "*",
        "firebase/php-jwt": "^7.2",
        "inertiajs/inertia-laravel": "^3.0",
        "ivanmitrikeski/laravel-shipping": "*",
        "jenssegers/agent": "*",
        "laravel-json-api/hashids": "^3.3",
        "laravel-json-api/laravel": "^5.3",
        "laravel/cashier": "*",
        "laravel/chisel": "^0.1.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.7",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "*",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "league/flysystem-aws-s3-v3": "^3.0",
        "milon/barcode": "*",
        "mll-lab/graphql-php-scalars": "^6.5",
        "mll-lab/laravel-graphiql": "^4.1",
        "nuwave/lighthouse": "^6.70",
        "pragmarx/google2fa": "*",
        "resend/resend-laravel": "^1.6",
        "spatie/laravel-analytics": "*",
        "spatie/laravel-medialibrary": "*",
        "spatie/laravel-permission": "*",
        "spatie/laravel-sitemap": "*",
        "spatie/laravel-sluggable": "*",
        "spatie/laravel-translatable": "*",
        "staudenmeir/laravel-adjacency-list": "^1.0",
        "stevebauman/location": "*",
        "stripe/stripe-php": "^17.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "*",
        "laravel-json-api/testing": "^3.2",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "*",
        "pestphp/pest-plugin-laravel": "^4.1",
        "rector/rector": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve --host=localhost\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "npm run lint:check",
            "npm run format:check",
            "npm run types:check",
            "@test"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": []
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
