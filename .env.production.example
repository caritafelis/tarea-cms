APP_NAME="stuvgraph"
APP_ENV=production
APP_KEY=                      # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://studio.stuvvion.com
APP_DOMAIN=studio.stuvvion.com  # varios: "cms.tudominio.com api.tudominio.com"
ACME_EMAIL=admin@stuvvion.com
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Base de datos (RDS MySQL / DO Managed MySQL) ---
DB_CONNECTION=mysql
DB_HOST=tu-instancia.xxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=stuvgraph
DB_USERNAME=stuvgraph_app
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/rds-global-bundle.pem   # DO: monta el ca.pem y apunta aqui

# --- Redis (contenedor local; con ElastiCache usa su endpoint y TLS) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=               # openssl rand -hex 32
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

# --- S3 (AWS) / Spaces (DigitalOcean) ---
FILESYSTEM_DISK=s3
MEDIA_DISK=s3
MEDIA_CONVERSIONS_DISK=s3
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# En EC2 usa un IAM Role y deja las llaves vacias. En Droplet/Spaces rellena:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_URL=                      # CDN/CloudFront o https://<bucket>.s3.<region>.amazonaws.com
AWS_ENDPOINT=                 # Spaces: https://nyc3.digitaloceanspaces.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- API / seguridad ---
CORS_ALLOWED_ORIGINS=https://sitio-cliente1.com,https://sitio-cliente2.com
SANCTUM_STATEFUL_DOMAINS=studio.stuvvion.com
SANCTUM_EXPIRATION=43200
LIGHTHOUSE_SECURITY_DISABLE_INTROSPECTION=true

# --- Tuning (servidor de 2 GB RAM). Formula: PHP_FPM_MAX_CHILDREN ~ (RAM para PHP) / 60 MB ---
APP_MEM_LIMIT=768m
APP_CPUS=1.5
WORKER_MEM_LIMIT=384m
PHP_FPM_MAX_CHILDREN=12
REDIS_MAXMEMORY=256mb

# --- Mail / pagos: tus claves (RESEND_API_KEY, STRIPE_*, NUVEI_*, etc.) ---